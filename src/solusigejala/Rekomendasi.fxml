<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="TOP_CENTER" maxHeight="Infinity" maxWidth="Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="555.0" prefWidth="875.0" spacing="20.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="solusigejala.RekomendasiSolusiController">
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
   <children>
      <Label text="Cari Rekomendasi Solusi Gejala Latihan Pernapasan">
         <font>
            <Font name="System Bold" size="18.0" />
         </font>
         <VBox.margin>
            <Insets top="10.0" /> </VBox.margin>
      </Label>
      <HBox alignment="CENTER" spacing="10.0" maxWidth="600.0"> <children>
            <ComboBox fx:id="gejalaComboBox" HBox.hgrow="ALWAYS" promptText="Pilih Gejala" />
            <Button mnemonicParsing="false" onAction="#handleSearchButtonAction" text="Cari" />
         </children>
         <VBox.margin>
            <Insets left="20.0" right="20.0" /> </VBox.margin>
      </HBox>
      <Separator prefWidth="200.0" VBox.vgrow="NEVER"> <VBox.margin>
            <Insets left="20.0" right="20.0" /> </VBox.margin>
      </Separator>
      <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" maxWidth="Infinity" HBox.hgrow="ALWAYS">
         <content>
            <VBox fx:id="resultContainer" alignment="TOP_LEFT" spacing="10.0">
               <padding>
                  <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
               </padding>
            </VBox>
         </content>
         <VBox.margin>
            <Insets left="20.0" right="20.0" /> </VBox.margin>
      </ScrollPane>
      <Button mnemonicParsing="false" onAction="#goBack" text="Kembali" VBox.vgrow="NEVER"> <VBox.margin>
            <Insets bottom="10.0" top="10.0" /> </VBox.margin>
      </Button>
   </children>
</VBox>