                        <Button fx:id="stopButton" disable="true" onAction="#stopBreathing" prefHeight="45.0" prefWidth="150.0" text="Berhenti" />
                    </children>
                    <padding>
                        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
